# Aucune de ces variables n'est obligatoire pour démarrer : sans elles, la
# plateforme tourne en mode démonstration avec un contenu d'exemple.
#
# ATTENTION : sans base de données, rien n'est conservé. En serverless, deux
# requêtes consécutives peuvent tomber sur deux instances différentes, donc ce
# qu'on vient d'écrire disparaît. C'est la première variable à renseigner.

# N'importe quel Postgres fait l'affaire : Neon (ajoutée automatiquement par
# Vercel), Supabase, Railway, Render, ou une machine à soi. Neon est reconnu et
# interrogé en HTTP, ce qui est le plus rapide en serverless ; tout le reste
# passe par un pilote classique.
# Sont aussi acceptées, dans cet ordre : POSTGRES_URL, POSTGRES_PRISMA_URL,
# DATABASE_URL_UNPOOLED, POSTGRES_URL_NON_POOLING, NEON_DATABASE_URL.
DATABASE_URL=

# Ajouté automatiquement par Vercel quand on crée un Blob store. Sans lui, les
# photos importées ne sont pas conservées non plus.
BLOB_READ_WRITE_TOKEN=

# Code d'entrée partagé. Sans lui, le code est « nous ».
APP_PASSCODE=

# Longue suite de caractères au hasard, qui signe les sessions.
AUTH_SECRET=
